# Copie para .env (não versionado) e ajuste. Os valores abaixo servem só para a máquina local.
# Usado pelo docker compose:
POSTGRES_DB=prumo_db
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=5433
# Interface em que o banco escuta. 127.0.0.1 = só esta máquina; 0.0.0.0 = toda a rede.
POSTGRES_BIND=127.0.0.1

# Usado pela aplicação (application.yaml). Exporte no shell ou configure na IDE:
SERVER_PORT=8080
# Interface em que o backend escuta. 127.0.0.1 = só esta máquina (o front acessa daqui); 0.0.0.0 = toda a rede.
SERVER_ADDRESS=127.0.0.1
DATASOURCE_URL=jdbc:postgresql://localhost:5433/prumo_db?sslmode=disable
DATASOURCE_USERNAME=app
DATASOURCE_PASSWORD=app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

JWT_PRIVATE_KEY_PATH=file:./keys/private.pem
JWT_PUBLIC_KEY_PATH=file:./keys/public.pem
JWT_ISSUER=prumo
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Chave que cifra os tokens do GitHub salvos (32 bytes em Base64): openssl rand -base64 32
PRUMO_ENCRYPTION_KEY=
GITHUB_POLLING_ENABLED=true
GITHUB_POLLING_INTERVAL=60s
