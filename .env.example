# Copie para .env (não versionado) e ajuste. Os valores abaixo servem só para a máquina local.
# Usado pelo docker compose:
POSTGRES_DB=prumo_db
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=5433

# Usado pela aplicação (application.yaml). Exporte no shell ou configure na IDE:
SERVER_PORT=8080
DATASOURCE_URL=jdbc:postgresql://localhost:5433/prumo_db?sslmode=disable
DATASOURCE_USERNAME=app
DATASOURCE_PASSWORD=app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
