# Copie para .env.mode.lan (não versionado) e preencha com o app OAuth da rede.
# Troque <host> pelo nome (MeuMac.local) ou IP fixo do computador que roda o Prumo.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://<host>:3000/login/oauth2/code/github
FRONTEND_OAUTH_CALLBACK_URL=http://<host>:3000/auth/callback
DEV_ALLOWED_ORIGINS=<host>
